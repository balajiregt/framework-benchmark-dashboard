{
  "name": "framework-benchmark-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "python3 -m unittest discover -s tests -p '*_test.py' && node --test tests/*.test.mjs",
    "preview": "python3 -m http.server 4397 --bind 127.0.0.1 --directory dist",
    "import": "python3 scripts/import_benchmarks.py --sources sources.local.json",
    "workflow:prepare": "python3 workflows/campaign.py prepare",
    "workflow:run": "python3 workflows/campaign.py run --publish",
    "workflow:publish": "python3 workflows/publish.py",
    "impact:audit": "python3 impact/audit.py",
    "impact:prepare": "python3 impact/run.py prepare",
    "impact:run": "python3 impact/run.py run --publish",
    "impact:publish": "python3 impact/publish.py"
  },
  "engines": {
    "node": ">=22"
  }
}
